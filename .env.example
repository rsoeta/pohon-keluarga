# ==============================================================================
# Pohon Keluarga — Contoh Konfigurasi Environment
# Salin menjadi `frontend/.env` saat build lokal/produksi.
# JANGAN PERNAH mengisi token rahasia / API key WA Gateway di file frontend!
# ==============================================================================

# URL Web App Google Apps Script hasil Deploy (akhiran /exec)
VITE_API_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec

# Domain aplikasi PWA
VITE_APP_DOMAIN=www.altasim.studio-pasti.net

# Mode debug frontend (WAJIB false untuk produksi)
VITE_DEBUG=false

# ==============================================================================
# Catatan Script Properties Backend GAS (Set di Apps Script -> Project Settings,
# atau otomatis dibuat oleh setupSheets() — JANGAN taruh di Git):
#   SPREADSHEET_ID   = ID Google Spreadsheet 5 sheet (otomatis jika bound script)
#   FOTO_FOLDER_ID   = ID folder Google Drive privat (dibuat oleh setupSheets())
#   SESSION_SECRET   = Kunci HMAC token sesi (dibuat acak oleh setupSheets())
#   PASSWORD_PEPPER  = Pepper HMAC untuk hashing password (dibuat oleh setupSheets())
#   WA_GATEWAY_TOKEN = API Key / Token WhatsApp Gateway (isi via Panel Admin / GAS)
#   DEBUG_MODE       = false (WAJIB false untuk produksi)
# ==============================================================================
